{
  "atomCode": "xunit-report",
  "name": ".NET test report",
  "version": "1.1.0",
  "description": "Reads .NET test reports: NUnit 3/2, MSTest and dotnet test TRX, xUnit.net. Not JUnit XML.",
  "execution": {
    "packagePath": "xunit-report.jar",
    "language": "java",
    "target": "$atom_java_path -cp xunit-report.jar com.jenkinschina.atom.sdk.AtomRunner"
  },
  "input": {
    "testResults": {
      "label": "报告 glob",
      "type": "vuex-input",
      "default": "**/TestResults/*.trx, **/*.trx, **/TestResults/*.xml, **/test-results*.xml, **/nunit*.xml, **/xunit*.xml"
    },
    "label": {
      "label": "报告名称",
      "type": "vuex-input",
      "default": ".NET tests"
    },
    "outputDir": {
      "label": "HTML 输出目录",
      "type": "vuex-input",
      "default": "out/xunit"
    },
    "allowEmptyResults": {
      "label": "没有报告不算失败",
      "type": "checkbox",
      "default": "false"
    },
    "failOnFailure": {
      "label": "有失败用例就让这一步失败",
      "type": "checkbox",
      "default": "false"
    },
    "skipMarkingUnstable": {
      "label": "不把构建标为 UNSTABLE",
      "type": "checkbox",
      "default": "false"
    }
  },
  "output": {
    "total": {
      "type": "string",
      "description": "用例数"
    },
    "passed": {
      "type": "string",
      "description": "通过"
    },
    "failed": {
      "type": "string",
      "description": "失败"
    },
    "skipped": {
      "type": "string",
      "description": "跳过"
    },
    "report": {
      "type": "report",
      "description": "构建页内嵌报告"
    },
    "errors": {
      "type": "string",
      "description": "tests that neither passed, failed nor were skipped (error, timeout, warning)"
    },
    "formats": {
      "type": "string",
      "description": "report shapes found, comma separated: nunit3 / nunit2 / mstest-trx / xunit-net"
    }
  },
  "x-jenkins": {
    "protocol": "jenkins-1",
    "requires": {
      "runner": ">=0.4.0"
    }
  }
}
